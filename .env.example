# Address of the customer API, e.g. https://api.example.com/api/v1 (empty = same host)
VITE_API_BASE_URL=
# Set to true ONLY in a build made for testers: shows buttons that play the payment provider on a test server.
VITE_TEST_PANEL=

# Enable only after the matching Laravel Firebase exchange endpoint is deployed and tested.
VITE_FIREBASE_AUTH_ENABLED=false
# Public Firebase WEB configuration. Never put the Firebase Admin service-account key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
